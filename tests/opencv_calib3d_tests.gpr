with "opencv_calib3d.gpr";
with "aunit.gpr";
with "config/opencv_calib3d_tests_config.gpr";

project Opencv_Calib3D_Tests is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "config", "layout");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("run_tests.adb");
   for Create_Missing_Dirs use "True";
   package Compiler is
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-Werror");
      for Default_Switches ("Ada") use
        Opencv_Calib3D_Tests_Config.Ada_Compiler_Switches & ("-gnatwa", "-gnatwe", "-Werror");
   end Compiler;
   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end Opencv_Calib3D_Tests;
